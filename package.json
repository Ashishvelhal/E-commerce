{
  "name": "ecommerce-3d-mern",
  "version": "1.0.0",
  "description": "Full-Stack 3D MERN TypeScript E-Commerce Platform",
  "author": {
    "name": "Rasin Arts Studio",
    "email": "support@rasinarts.com"
  },
  "homepage": "https://rasinarts.com",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\" \"npx wait-on http://localhost:5173 && npx electron electron/main.cjs\"",
    "desktop": "npm run electron:dev",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.rasinarts.studio",
    "productName": "Rasin Arts Luxury 3D Studio",
    "copyright": "Copyright © 2026 Rasin Arts",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/dist/**/*"
    ],
    "asarUnpack": [
      "backend/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  }
}
